# API URL para builds Android
# Copie este arquivo para .env.local e ajuste o IP conforme seu ambiente:

# Dispositivo físico na mesma rede Wi-Fi:
VITE_API_BASE_URL_ANDROID=http://192.168.1.XXX:3333/api/v1

# Emulador Android (10.0.2.2 aponta para o localhost da máquina host):
# VITE_API_BASE_URL_ANDROID=http://10.0.2.2:3333/api/v1
