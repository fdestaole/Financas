ENV=development
PORT=3333
DATABASE_URL=postgresql+psycopg://financas:financas@localhost:5432/financas
JWT_ACCESS_SECRET=changeme-access-secret-please
JWT_REFRESH_SECRET=changeme-refresh-secret-please
# Opcional: chave HMAC para hashear refresh tokens em DB. Se vazia, deriva do JWT_REFRESH_SECRET.
REFRESH_HASH_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
